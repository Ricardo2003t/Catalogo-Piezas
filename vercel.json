{
  "routes": [
    {
      "src": "^/producto/([^/]+)/?$",
      "methods": ["GET"],
      "dest": "/api/index?producto=$1"
    },
    {
      "src": "^/$",
      "methods": ["GET"],
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}